# Copy to .env.local and fill in. Never commit real values.
# Server-only: none of these are exposed to the browser (no NEXT_PUBLIC_ prefix).

# HoomanLabs API secret token (sent as the Authorization header)
HOOMAN_API_TOKEN=

# Campaign the demo call tasks are created in
HOOMAN_CAMPAIGN_ID=

# Demo agent id per use case
HOOMAN_AGENT_COLLECTIONS=
HOOMAN_AGENT_APPOINTMENTS=
HOOMAN_AGENT_SUPPORT=
HOOMAN_AGENT_SALES=

# Optional: calling window as HHMM in the caller's timezone (default 0..2359)
# HOOMAN_CALL_START=930
# HOOMAN_CALL_END=1830

# Optional: override the API endpoint
# HOOMAN_API_URL=https://api.hoomanlabs.com/routes/v1/tasks/
